# Copy to .env locally. Never commit real credentials.

# Spring
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# PostgreSQL (source of truth)
DATABASE_URL=jdbc:postgresql://localhost:5432/fulfilment
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=

# HTTP
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Domain timers (minutes)
RESERVATION_EXPIRY_MINUTES=30
RECONCILIATION_STALE_PENDING_MINUTES=60

# Development seed (catalogue only). Leave false unless you explicitly want sample rows.
APP_SEED_ENABLED=false

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
